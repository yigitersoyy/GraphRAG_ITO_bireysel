# Names and non-secret defaults only. Copy to .env (ignored) and fill in locally.
APP_ENV=development
WORKSPACE_ID=default
LOG_LEVEL=INFO
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=                 # required; choose a strong local password
LLM_PROVIDER=lmstudio
LM_STUDIO_INSTANCE_ID=local-lmstudio
LLM_BASE_URL=http://127.0.0.1:1234/v1
# LM_STUDIO_API_KEY=            # only if LM Studio / gateway auth is enabled
EXTRACTION_MODEL=               # exact served chat model id
ANSWER_MODEL=
EMBEDDING_PROVIDER=lmstudio
EMBEDDING_BASE_URL=http://127.0.0.1:1234/v1
EMBEDDING_MODEL=                # exact served embedding model id
EMBEDDING_DIMENSIONS=1024
EMBEDDING_PROFILE=qwen3-embedding-0.6b-local-v1
LM_STUDIO_CONTEXT_TOKENS=8192
MAX_CONTEXT_TOKENS=4096
EXTRACTION_MAX_OUTPUT_TOKENS=2048
ANSWER_MAX_OUTPUT_TOKENS=1024

# Compose only. 1 = deterministic demo providers (no LM Studio needed).
GRAPHRAG_DEMO=0
