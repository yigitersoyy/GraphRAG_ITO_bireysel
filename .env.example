# Local Python addresses. Compose uses COMPOSE_* independently.
APP_ENV=development
WORKSPACE_ID=default
LOG_LEVEL=INFO
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
LLM_PROVIDER=lmstudio
LM_STUDIO_INSTANCE_ID=local-lmstudio
LLM_BASE_URL=http://127.0.0.1:1234/v1
EMBEDDING_BASE_URL=http://127.0.0.1:1234/v1
COMPOSE_LLM_BASE_URL=http://host.docker.internal:1234/v1
COMPOSE_EMBEDDING_BASE_URL=http://host.docker.internal:1234/v1
# Set tokens only if your server requires authentication.
# LM_STUDIO_API_KEY=
# EMBEDDING_API_KEY=
EXTRACTION_MODEL=
ANSWER_MODEL=
CHAT_TEMPERATURE=0
# Optional model-specific instruction, for example "\n/no_think" for Qwen3.
LLM_INSTRUCTION_SUFFIX=""
CHAT_TEMPLATE_ENABLE_THINKING=false
EMBEDDING_PROVIDER=lmstudio
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024
EMBEDDING_PROFILE=qwen3-embedding-0.6b-local-v1
# Match query/document preprocessing to the selected embedding model.
EMBEDDING_QUERY_TEMPLATE="Instruct: Given a question about personal notes, retrieve passages that answer the question.\nQuery:{question}"
EMBEDDING_DOCUMENT_PREFIX=""
LM_STUDIO_CONTEXT_TOKENS=8192
MAX_CONTEXT_TOKENS=4096
EXTRACTION_MAX_OUTPUT_TOKENS=2048
ANSWER_MAX_OUTPUT_TOKENS=1024
PROVIDER_TIMEOUT_SECONDS=120
QUESTION_TIMEOUT_SECONDS=180
CAPABILITY_PROBE_MAX_AGE_HOURS=24
GRAPHRAG_DEMO=0
# PDF/Word/Excel file bytes; extracted note text still uses MAX_NOTE_CHARS/MAX_NOTE_BYTES.
MAX_UPLOAD_BYTES=10485760
# Optional one-click launcher overrides. Defaults match this machine's existing model files.
# LAUNCH_CHAT_MODEL=qwen/qwen3.5-9b
# LAUNCH_EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5-GGUF/nomic-embed-text-v1.5.Q4_K_M.gguf
# LAUNCH_CHAT_GPU=0.8
# LAUNCH_DOCKER_DESKTOP=C:/Program Files/Docker/Docker/Docker Desktop.exe
